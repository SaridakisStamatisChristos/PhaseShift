# The generated witnesses must compile as C++20 using ONLY the standard
# library; compilation is tested, not guessed from a readable source file.
set(root "@CMAKE_CURRENT_BINARY_DIR@/ctest_reproducer")
file(REMOVE_RECURSE "${root}")
file(MAKE_DIRECTORY "${root}")
set(binary "@CMAKE_CURRENT_BINARY_DIR@/phaseshift")
set(cxx "@CMAKE_CXX_COMPILER@")
foreach(family IN ITEMS sort topk graph calibrate)
 if(family STREQUAL "sort")
  set(cfg "{\"experiment_id\":\"standalone-sort\",\"problem_family\":\"integer_array\",\"algorithms\":[\"std_sort\"],\"axes\":{\"n\":{\"values\":[64]}},\"fixed\":{\"distribution\":\"uniform\"},\"search\":{\"method\":\"grid\",\"max_cases\":1},\"measurement\":{\"paired_discovery_blocks\":1}}")
  set(algorithms std_sort mergesort insertion_sort quicksort_first_pivot)
 elseif(family STREQUAL "topk")
  set(cfg "{\"experiment_id\":\"standalone-topk\",\"problem_family\":\"topk\",\"algorithms\":[\"topk_full_sort\"],\"axes\":{\"n\":{\"values\":[48]}},\"fixed\":{\"k\":9,\"distribution\":\"heavy_duplicate\"},\"search\":{\"method\":\"grid\",\"max_cases\":1},\"measurement\":{\"paired_discovery_blocks\":1}}")
  set(algorithms topk_full_sort topk_heap topk_nth)
 elseif(family STREQUAL "graph")
  set(cfg "{\"experiment_id\":\"standalone-graph\",\"problem_family\":\"graph\",\"algorithms\":[\"dijkstra_heap\"],\"axes\":{\"vertices\":{\"values\":[12]}},\"fixed\":{\"edges\":25,\"weight_class\":\"zero_one\",\"directed\":false},\"search\":{\"method\":\"grid\",\"max_cases\":1},\"measurement\":{\"paired_discovery_blocks\":1}}")
  set(algorithms bellman_ford dijkstra_heap dijkstra_dense zero_one_bfs)
 else()
  set(cfg "{\"experiment_id\":\"standalone-calibration\",\"problem_family\":\"calibration\",\"algorithms\":[\"calibration\"],\"axes\":{\"x\":{\"values\":[8]}},\"fixed\":{\"threshold\":8},\"search\":{\"method\":\"grid\",\"max_cases\":1},\"measurement\":{\"paired_discovery_blocks\":1}}")
  set(algorithms calibration)
 endif()
 file(WRITE "${root}/${family}.json" "${cfg}")
 execute_process(COMMAND "${binary}" explore --config "${root}/${family}.json" --out "${root}/${family}"
   RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE error)
 if(NOT status EQUAL 0)
  message(FATAL_ERROR "reproducer fixture explore ${family} failed: ${status} ${output} ${error}")
 endif()
 file(READ "${root}/${family}/report.json" report)
 string(JSON case_id GET "${report}" raw_samples 0 case_id)
 if(family STREQUAL "sort")
  set(sort_case_id "${case_id}")
 endif()
 foreach(algorithm IN LISTS algorithms)
  set(source "${root}/${family}-${algorithm}.cpp")
  set(exe "${root}/${family}-${algorithm}")
  execute_process(COMMAND "${binary}" reproduce --run "${root}/${family}" --case "${case_id}" --algorithm "${algorithm}" --out "${source}"
    RESULT_VARIABLE code ERROR_VARIABLE error)
  if(NOT code EQUAL 0 OR NOT EXISTS "${source}")
   message(FATAL_ERROR "cannot generate standalone ${algorithm}: ${code} ${error}")
  endif()
  execute_process(COMMAND "${cxx}" -std=c++20 -O0 -Wall -Wextra -Wpedantic -Werror "${source}" -o "${exe}"
    RESULT_VARIABLE code ERROR_VARIABLE error)
  if(NOT code EQUAL 0)
   message(FATAL_ERROR "standalone ${algorithm} did not compile without PHASESHIFT libraries: ${error}")
  endif()
  execute_process(COMMAND "${exe}" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
  if(NOT code EQUAL 0 OR NOT output MATCHES "PASS: standalone case/oracle agreement")
   message(FATAL_ERROR "standalone ${algorithm} output mismatch: ${code} ${output} ${error}")
  endif()
 endforeach()
endforeach()
execute_process(COMMAND "${binary}" reproduce --run "${root}/sort" --case "${sort_case_id}" --algorithm "plugin:/invalid.so" --out "${root}/bad.cpp" RESULT_VARIABLE code)
if(code EQUAL 0 OR EXISTS "${root}/bad.cpp")
 message(FATAL_ERROR "standalone plugin generation must be rejected")
endif()

execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift_reproducer_unit" "${root}/extreme.cpp"
 RESULT_VARIABLE code ERROR_VARIABLE error)
if(NOT code EQUAL 0)
 message(FATAL_ERROR "extreme numeric reproducer failed: ${error}")
endif()
execute_process(COMMAND "${cxx}" -std=c++20 -O0 -Wall -Wextra -Wpedantic -Werror "${root}/extreme.cpp" -o "${root}/extreme"
 RESULT_VARIABLE code ERROR_VARIABLE error)
if(NOT code EQUAL 0)
 message(FATAL_ERROR "standalone extreme numeric case did not compile: ${error}")
endif()
execute_process(COMMAND "${root}/extreme" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT code EQUAL 0 OR NOT output MATCHES "PASS: standalone case/oracle agreement")
 message(FATAL_ERROR "standalone extreme numeric mismatch: ${output} ${error}")
endif()

execute_process(COMMAND "${cxx}" -std=c++20 -O0 -Wall -Wextra -Wpedantic -Werror "${root}/extreme.cpp.empty.cpp" -o "${root}/empty_topk"
 RESULT_VARIABLE code ERROR_VARIABLE error)
if(NOT code EQUAL 0)
 message(FATAL_ERROR "standalone empty TopK did not compile: ${error}")
endif()
execute_process(COMMAND "${root}/empty_topk" RESULT_VARIABLE code OUTPUT_VARIABLE output ERROR_VARIABLE error)
if(NOT code EQUAL 0 OR NOT output MATCHES "PASS: standalone case/oracle agreement, 0 output values")
 message(FATAL_ERROR "standalone empty TopK mismatch: ${output} ${error}")
endif()
