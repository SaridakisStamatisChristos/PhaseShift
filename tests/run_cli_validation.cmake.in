set(binary "@CMAKE_CURRENT_BINARY_DIR@/phaseshift")
set(root "@CMAKE_CURRENT_BINARY_DIR@/ctest_cli_validation")
file(REMOVE_RECURSE "${root}")
file(MAKE_DIRECTORY "${root}")
foreach(command "doctor;--unsupported-flag" "--version;--bogus" "--help;--bogus" "list;families;--bogus" "replay;--run;/tmp/no;--case;deadbeef;--db;/tmp/no.sqlite;--unexpected;x" "validate;--config" "validate;--config;x;--config;y" "demo;--out")
 string(REPLACE ";" ";" argv "${command}")
 execute_process(COMMAND "${binary}" ${argv} RESULT_VARIABLE rc OUTPUT_QUIET ERROR_VARIABLE err)
 if(rc EQUAL 0)
  message(FATAL_ERROR "CLI accepted malformed args [${command}]")
 endif()
endforeach()
file(READ "@CMAKE_CURRENT_SOURCE_DIR@/configs/topk_fraction.json" valid)
string(REGEX REPLACE "\"paired_discovery_blocks\"" "\"primary_metric\":\"cpu_ns_per_operation\",\"paired_discovery_blocks\"" wrong "${valid}")
file(WRITE "${root}/unsupported_metric.json" "${wrong}")
execute_process(COMMAND "${binary}" validate --config "${root}/unsupported_metric.json" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
if(rc EQUAL 0)
 message(FATAL_ERROR "unsupported CPU primary metric silently accepted")
endif()
string(REGEX REPLACE "\"paired_discovery_blocks\"" "\"unsupported_science_key\":7,\"paired_discovery_blocks\"" wrong "${valid}")
file(WRITE "${root}/unknown_measurement.json" "${wrong}")
execute_process(COMMAND "${binary}" validate --config "${root}/unknown_measurement.json" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
if(rc EQUAL 0)
 message(FATAL_ERROR "unknown measurement key silently accepted")
endif()
file(READ "@CMAKE_CURRENT_SOURCE_DIR@/configs/graph_density.json" valid)
string(REPLACE "dijkstra_heap" "plugin:/tmp/deliberately_unsupported.so" wrong "${valid}")
file(WRITE "${root}/unsupported_plugin_family.json" "${wrong}")
execute_process(COMMAND "${binary}" validate --config "${root}/unsupported_plugin_family.json" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
if(rc EQUAL 0)
 message(FATAL_ERROR "graph family accepted integer_array-only native plugin")
endif()
# Verify explicitly supplied --db is consulted, not ignored. Valid replay
# is already covered in the end-to-end acceptance script.
execute_process(COMMAND "${binary}" replay --run "${root}" --case abcd --db "${root}/nonexistent.sqlite" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
if(rc EQUAL 0)
 message(FATAL_ERROR "replay ignored nonexistent --db")
endif()
message(STATUS "CLI strictness and measurement-schema validation PASS")
