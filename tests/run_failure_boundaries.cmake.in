set(root "@CMAKE_CURRENT_BINARY_DIR@/ctest_failure_boundaries")
file(REMOVE_RECURSE "${root}")
file(MAKE_DIRECTORY "${root}")
foreach(case IN ITEMS correctness resource)
 if(case STREQUAL "correctness")
  set(plugin "@CMAKE_CURRENT_BINARY_DIR@/reverse_sort.so")
  set(expected_kind "CORRECTNESS_BOUNDARY")
  set(expected_status "wrong_answer")
 else()
  set(plugin "@CMAKE_CURRENT_BINARY_DIR@/threshold_resource.so")
  set(expected_kind "MEMORY_OR_RESOURCE_BOUNDARY")
  set(expected_status "out_of_memory")
 endif()
 file(WRITE "${root}/${case}.json" "{\"schema_version\":1,\"experiment_id\":\"${case}-failure-injected\",\"problem_family\":\"integer_array\",\"algorithms\":[\"plugin:${plugin}\",\"std_sort\"],\"primary_axis\":\"n\",\"axes\":{\"n\":{\"values\":[1,2,3,5,8,16]}},\"fixed\":{\"distribution\":\"ascending\",\"value_range\":1000000},\"search\":{\"method\":\"grid\",\"max_cases\":6},\"measurement\":{\"paired_discovery_blocks\":2,\"paired_confirm_blocks\":20,\"warmup_iterations\":0},\"limits\":{\"total_wall_seconds\":90,\"max_sample_wall_ms\":1000}}")
 set(run "${root}/${case}_run")
 foreach(action IN ITEMS explore confirm minimize)
  if(action STREQUAL "explore")
   execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" explore --config "${root}/${case}.json" --out "${run}" RESULT_VARIABLE rc ERROR_VARIABLE err)
  else()
   execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" "${action}" --run "${run}" RESULT_VARIABLE rc ERROR_VARIABLE err)
  endif()
  if(NOT rc EQUAL 0)
   message(FATAL_ERROR "${case} ${action} failed: ${rc}: ${err}")
  endif()
 endforeach()
 file(READ "${run}/report.json" report)
 string(JSON kind GET "${report}" summary hypotheses 0 kind)
 string(JSON status GET "${report}" summary hypotheses 0 status)
 string(JSON bad_count GET "${report}" summary invalid_samples)
 if(NOT kind STREQUAL expected_kind OR NOT status STREQUAL "MINIMIZED_CONFIRMED" OR bad_count LESS 20)
  message(FATAL_ERROR "${case} not a confirmed persistent censored boundary: kind=${kind} verdict=${status} failures=${bad_count}")
 endif()
 file(READ "${run}/witness.json" witness)
 string(JSON witness_id GET "${witness}" case_id)
 execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" replay --run "${run}" --case "${witness_id}" --algorithm "plugin:${plugin}" --expect "${expected_status}" RESULT_VARIABLE rc ERROR_VARIABLE err)
 if(NOT rc EQUAL 0)
  message(FATAL_ERROR "${case} exact failure witness replay failed: ${err}")
 endif()
 execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" export --run "${run}" --out "${root}/${case}_bundle" RESULT_VARIABLE rc ERROR_VARIABLE err)
 if(NOT rc EQUAL 0)
  message(FATAL_ERROR "${case} evidence export/verification failed: ${err}")
 endif()
endforeach()
