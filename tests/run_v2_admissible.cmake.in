set(RUN "@CMAKE_CURRENT_BINARY_DIR@/v2_admissible_ctest")
file(REMOVE_RECURSE "@CMAKE_CURRENT_BINARY_DIR@/v2_admissible_ctest")
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" validate --config "@CMAKE_CURRENT_SOURCE_DIR@/configs/v2/admissible_calibration.json" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "admissible v2 validate failed")
endif()
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" explore --config "@CMAKE_CURRENT_SOURCE_DIR@/configs/v2/admissible_calibration.json" --out "@CMAKE_CURRENT_BINARY_DIR@/v2_admissible_ctest" --pause-after 3 RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "admissible v2 explore failed")
endif()
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" resume --run "@CMAKE_CURRENT_BINARY_DIR@/v2_admissible_ctest" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "admissible v2 resume failed")
endif()
execute_process(COMMAND "@Python3_EXECUTABLE@" "@CMAKE_CURRENT_SOURCE_DIR@/tests/verify_v2_admissible.py" --run "@CMAKE_CURRENT_BINARY_DIR@/v2_admissible_ctest" --binary "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" --config "@CMAKE_CURRENT_SOURCE_DIR@/configs/v2/admissible_calibration.json" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "admissible v2 independent verification failed")
endif()
