set(RUN "@CMAKE_CURRENT_BINARY_DIR@/v2_multi_ctest")
file(REMOVE_RECURSE "${RUN}")
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" explore --config "@CMAKE_CURRENT_SOURCE_DIR@/configs/v2/multi_change_calibration.json" --out "${RUN}" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "multi-change v2 exploration failed")
endif()
execute_process(COMMAND "@Python3_EXECUTABLE@" "@CMAKE_CURRENT_SOURCE_DIR@/tests/verify_v2_multi.py" --run "${RUN}" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "multi-change v2 ground truth diagnostic failed")
endif()
