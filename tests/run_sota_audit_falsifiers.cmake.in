# Independent regression cases from the 2026-11-20 SOTA audit.
set(binary "@CMAKE_CURRENT_BINARY_DIR@/phaseshift")
set(root "@CMAKE_CURRENT_BINARY_DIR@/ctest_sota_audit")
file(REMOVE_RECURSE "${root}")
file(MAKE_DIRECTORY "${root}")
file(READ "@CMAKE_CURRENT_SOURCE_DIR@/configs/sorting_quicksort.json" valid)
function(reject label content)
 file(WRITE "${root}/${label}.json" "${content}")
 execute_process(COMMAND "${binary}" validate --config "${root}/${label}.json"
  RESULT_VARIABLE rc OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 5)
 if(NOT "${rc}" STREQUAL "2" OR NOT "${stderr}" MATCHES "PHASESHIFT error:")
  message(FATAL_ERROR "Malformed configuration ${label} did not fail safely; exit=${rc}, out=${stdout}, err=${stderr}")
 endif()
endfunction()
string(JSON broken SET "${valid}" algorithms "[null]")
reject(null_algorithm "${broken}")
string(JSON broken SET "${valid}" algorithms "[\"std_sort\",null]")
reject(second_null_algorithm "${broken}")
string(JSON broken SET "${valid}" fixed "1")
reject(integer_fixed "${broken}")
string(JSON broken SET "${valid}" search "\"adaptive_partition\"")
reject(string_search "${broken}")
string(JSON broken SET "${valid}" detection "\"invalid\"")
reject(string_detection "${broken}")
string(JSON broken SET "${valid}" search sampler_algorithm "\"unsupported\"")
reject(unknown_search "${broken}")
string(JSON broken SET "${valid}" detection fake_confidence "0.1")
reject(unknown_detection "${broken}")
string(JSON broken SET "${valid}" sarch "{}")
reject(unknown_root "${broken}")
string(JSON broken SET "${valid}" detectoin "{}")
reject(typo_root "${broken}")
string(JSON broken SET "${valid}" seed "-1")
reject(negative_seed "${broken}")
string(JSON broken SET "${valid}" limits max_cases "5.8")
reject(fractional_case_count "${broken}")
string(JSON broken SET "${valid}" measurement "null")
reject(null_measurement "${broken}")
string(JSON broken SET "${valid}" limits "null")
reject(null_limits "${broken}")
string(JSON broken SET "${valid}" schema_version "null")
reject(null_schema "${broken}")
string(JSON broken SET "${valid}" axes n "null")
reject(null_axis "${broken}")
string(JSON broken SET "${valid}" axes n "{\"values\":[64],\"typo\":true}")
reject(unknown_axis_setting "${broken}")
# A valid, compute-heavy input with a 1s total budget previously took 10.62s
# and returned 0. This must stop promptly and preserve a resumable DB.
string(JSON budget SET "${valid}" axes "{\"n\":{\"values\":[20000]},\"distribution\":{\"values\":[\"ascending\"]}}")
string(JSON budget SET "${budget}" search max_cases "1")
string(JSON budget SET "${budget}" limits total_wall_seconds "1")
string(JSON budget SET "${budget}" limits max_sample_wall_ms "3000")
string(JSON budget SET "${budget}" measurement paired_discovery_blocks "9")
file(WRITE "${root}/budget.json" "${budget}")
string(TIMESTAMP before "%s")
execute_process(COMMAND "${binary}" explore --config "${root}/budget.json" --out "${root}/partial"
 RESULT_VARIABLE rc OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr TIMEOUT 6)
string(TIMESTAMP after "%s")
math(EXPR elapsed "${after}-${before}")
if(NOT "${rc}" STREQUAL "2" OR NOT "${stderr}" MATCHES "total_wall_seconds budget exhausted" OR elapsed GREATER 4)
 message(FATAL_ERROR "Experiment ignored hard wall budget: rc=${rc} elapsed=${elapsed}s out=${stdout} err=${stderr}")
endif()
if(NOT EXISTS "${root}/partial/run.sqlite" OR NOT EXISTS "${root}/partial/report.json")
 message(FATAL_ERROR "Deadline did not preserve partial SQLite and report evidence")
endif()
message(STATUS "SOTA audit malformed JSON and hard global deadline regressions PASS")
