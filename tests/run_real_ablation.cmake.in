set(root "@CMAKE_CURRENT_BINARY_DIR@/ctest_real_ablation")
file(REMOVE_RECURSE "${root}")
file(MAKE_DIRECTORY "${root}")
file(WRITE "${root}/config.json" "{\"schema_version\":1,\"experiment_id\":\"real-sorting-ablation\",\"problem_family\":\"integer_array\",\"algorithms\":[\"std_sort\",\"mergesort\"],\"seed\":31337,\"primary_axis\":\"n\",\"axes\":{\"n\":{\"values\":[16,32,64,128,256,512,1024,2048]}},\"fixed\":{\"distribution\":\"uniform\",\"value_range\":100000},\"search\":{\"method\":\"adaptive_partition\",\"max_cases\":6},\"measurement\":{\"paired_discovery_blocks\":1,\"paired_confirm_blocks\":20,\"warmup_iterations\":0}}")
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" ablate --config "${root}/config.json" --out "${root}/ablation" RESULT_VARIABLE result ERROR_VARIABLE err)
if(NOT result EQUAL 0)
 message(FATAL_ERROR "real algorithm ablation failed: ${result}: ${err}")
endif()
file(READ "${root}/ablation/ablation.csv" csv)
foreach(method IN ITEMS grid random stratified adaptive_partition)
 if(NOT EXISTS "${root}/ablation/${method}/run.sqlite")
  message(FATAL_ERROR "real ablation method ${method} missing raw experiment database")
 endif()
 if(NOT csv MATCHES "${method},6,6,")
  message(FATAL_ERROR "real ablation ${method} did not complete equal six-case budget: ${csv}")
 endif()
 file(READ "${root}/ablation/${method}/report.json" report)
 string(JSON incorrect GET "${report}" summary invalid_samples)
 if(NOT incorrect EQUAL 0)
  message(FATAL_ERROR "real ablation ${method} violated correctness gate: ${incorrect}")
 endif()
endforeach()
