file(REMOVE_RECURSE "@CMAKE_CURRENT_BINARY_DIR@/ctest_demo")
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" demo --out "@CMAKE_CURRENT_BINARY_DIR@/ctest_demo" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Demo exited ${result}: ${stdout}\n${stderr}")
endif()
file(READ "@CMAKE_CURRENT_BINARY_DIR@/ctest_demo/report.json" report)
if(NOT report MATCHES "MINIMIZED_CONFIRMED")
  message(FATAL_ERROR "demo did not confirm and minimize synthetic transition: ${report}")
endif()
