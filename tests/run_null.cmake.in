file(REMOVE_RECURSE "@CMAKE_CURRENT_BINARY_DIR@/ctest_null")
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" explore --config "@CMAKE_CURRENT_SOURCE_DIR@/configs/negative_control.json" --out "@CMAKE_CURRENT_BINARY_DIR@/ctest_null" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Null test exited ${result}: ${stdout}\n${stderr}")
endif()
file(READ "@CMAKE_CURRENT_BINARY_DIR@/ctest_null/report.json" report)
if(NOT report MATCHES "NO_CONFIRMED_BOUNDARY")
  message(FATAL_ERROR "null incorrectly found boundary: ${report}")
endif()
