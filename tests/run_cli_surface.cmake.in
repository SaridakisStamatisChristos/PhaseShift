# Verify documented entry points and rejected malformed switches, rather than
# merely executing help text to inflate the line-coverage numerator.
set(binary "@CMAKE_CURRENT_BINARY_DIR@/phaseshift")
foreach(mode IN ITEMS no_args help version families algorithms)
 if(mode STREQUAL "no_args")
  execute_process(COMMAND "${binary}" RESULT_VARIABLE code OUTPUT_VARIABLE text ERROR_VARIABLE err)
  if(NOT code EQUAL 0 OR NOT text MATCHES "Usage:")
   message(FATAL_ERROR "no-args help contract failed: ${code}: ${text} ${err}")
  endif()
 elseif(mode STREQUAL "help")
  execute_process(COMMAND "${binary}" --help RESULT_VARIABLE code OUTPUT_VARIABLE text ERROR_VARIABLE err)
  if(NOT code EQUAL 0 OR NOT text MATCHES "Usage:")
   message(FATAL_ERROR "--help contract failed: ${code}: ${text} ${err}")
  endif()
 elseif(mode STREQUAL "version")
  execute_process(COMMAND "${binary}" --version RESULT_VARIABLE code OUTPUT_VARIABLE text ERROR_VARIABLE err)
  if(NOT code EQUAL 0 OR NOT text MATCHES "PHASESHIFT 1.0.0")
   message(FATAL_ERROR "version contract failed: ${code}: ${text} ${err}")
  endif()
 elseif(mode STREQUAL "families")
  execute_process(COMMAND "${binary}" list families RESULT_VARIABLE code OUTPUT_VARIABLE text ERROR_VARIABLE err)
  if(NOT code EQUAL 0 OR NOT text MATCHES "integer_array" OR NOT text MATCHES "graph")
   message(FATAL_ERROR "list families contract failed: ${code}: ${text} ${err}")
  endif()
 elseif(mode STREQUAL "algorithms")
  execute_process(COMMAND "${binary}" list algorithms RESULT_VARIABLE code OUTPUT_VARIABLE text ERROR_VARIABLE err)
  if(NOT code EQUAL 0 OR NOT text MATCHES "std_sort" OR NOT text MATCHES "topk_heap")
   message(FATAL_ERROR "list algorithms contract failed: ${code}: ${text} ${err}")
  endif()
 endif()
endforeach()
# Invalid invocations should fail predictably with a diagnostic (not a crash).
foreach(kind IN ITEMS invalid_list missing_list malformed_replay unknown_cmd missing_compare)
 if(kind STREQUAL "invalid_list")
  execute_process(COMMAND "${binary}" list nonsense RESULT_VARIABLE code ERROR_VARIABLE err)
 elseif(kind STREQUAL "missing_list")
  execute_process(COMMAND "${binary}" list RESULT_VARIABLE code ERROR_VARIABLE err)
 elseif(kind STREQUAL "malformed_replay")
  execute_process(COMMAND "${binary}" replay --run nowhere --case x --algorithm std_sort RESULT_VARIABLE code ERROR_VARIABLE err)
 elseif(kind STREQUAL "unknown_cmd")
  execute_process(COMMAND "${binary}" not-a-command --run nowhere RESULT_VARIABLE code ERROR_VARIABLE err)
 elseif(kind STREQUAL "missing_compare")
  execute_process(COMMAND "${binary}" compare --a nowhere RESULT_VARIABLE code ERROR_VARIABLE err)
 endif()
 if(NOT code EQUAL 2 OR NOT err MATCHES "PHASESHIFT error:")
  message(FATAL_ERROR "bad ${kind} accepted or crashed: ${code}: ${err}")
 endif()
endforeach()
