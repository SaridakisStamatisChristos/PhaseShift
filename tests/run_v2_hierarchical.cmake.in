set(RUN "@CMAKE_CURRENT_BINARY_DIR@/v2_hierarchical_ctest")
file(REMOVE_RECURSE "${RUN}")
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" validate --config "@CMAKE_CURRENT_SOURCE_DIR@/configs/v2/hierarchical_calibration.json" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "hierarchical v2 config rejected")
endif()
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" explore --config "@CMAKE_CURRENT_SOURCE_DIR@/configs/v2/hierarchical_calibration.json" --out "${RUN}" --pause-after 3 RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "hierarchical v2 partial run failed")
endif()
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" resume --run "${RUN}" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "hierarchical v2 exact resume failed")
endif()
