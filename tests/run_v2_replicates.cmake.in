set(RUN "@CMAKE_CURRENT_BINARY_DIR@/v2_replicate_ctest")
file(REMOVE_RECURSE "${RUN}")
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" validate --config "@CMAKE_CURRENT_SOURCE_DIR@/configs/v2/uniform_replicates.json" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "v2 replicate config invalid")
endif()
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" explore --config "@CMAKE_CURRENT_SOURCE_DIR@/configs/v2/uniform_replicates.json" --out "${RUN}" --pause-after 4 RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "v2 replicate first slice failed")
endif()
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" resume --run "${RUN}" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "v2 replicate resume mismatch")
endif()
execute_process(COMMAND "@Python3_EXECUTABLE@" "@CMAKE_CURRENT_SOURCE_DIR@/tests/verify_v2_replicates.py" --run "${RUN}" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "v2 replicate distinct-seed/coordinate evidence invalid")
endif()
