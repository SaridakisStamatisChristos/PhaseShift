set(ROOT "@CMAKE_CURRENT_BINARY_DIR@/resume_evidence")
file(REMOVE_RECURSE "${ROOT}")
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" explore --config "@CMAKE_CURRENT_SOURCE_DIR@/configs/demo_transition.json" --out "${ROOT}/part" --pause-after 3 RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "interrupted exploration failed: ${rc}")
endif()
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" resume --run "${ROOT}/part" --pause-after 3 RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "first resume failed: ${rc}")
endif()
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" resume --run "${ROOT}/part" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "final resume failed: ${rc}")
endif()
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" resume --run "${ROOT}/part" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
if(rc EQUAL 0)
  message(FATAL_ERROR "resuming a finalized run was accepted")
endif()
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" explore --config "@CMAKE_CURRENT_SOURCE_DIR@/configs/demo_transition.json" --out "${ROOT}/full" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
  message(FATAL_ERROR "full exploration failed: ${rc}")
endif()
file(READ "${ROOT}/part/report.json" part)
file(READ "${ROOT}/full/report.json" full)
string(JSON n1 GET "${part}" summary cases)
string(JSON n2 GET "${full}" summary cases)
if(NOT n1 EQUAL n2)
  message(FATAL_ERROR "resumed case count mismatch")
endif()
string(JSON hyp GET "${part}" summary hypotheses 0 status)
if(NOT hyp STREQUAL "HYPOTHESIZED")
  message(FATAL_ERROR "resumed hypothesis not detected")
endif()
file(REMOVE_RECURSE "${ROOT}")
