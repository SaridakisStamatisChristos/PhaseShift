set(RUN "@CMAKE_CURRENT_BINARY_DIR@/v2_factorial_holdout_ctest")
file(REMOVE_RECURSE "${RUN}")
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" explore
 --config "@CMAKE_CURRENT_SOURCE_DIR@/configs/v2/factorial_interaction.json"
 --out "${RUN}" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "factorial holdout discovery failed")
endif()
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" confirm-interaction
 --run "${RUN}" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "fixed independent factorial holdout failed")
endif()
execute_process(COMMAND "@Python3_EXECUTABLE@" "@CMAKE_CURRENT_SOURCE_DIR@/tests/verify_v2_factorial_holdout.py"
 --run "${RUN}" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "factorial independent holdout SQL verification failed")
endif()
# The raw holdout is immutable: a second invocation must fail, never overwrite.
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" confirm-interaction
 --run "${RUN}" RESULT_VARIABLE rc)
if(rc EQUAL 0)
 message(FATAL_ERROR "duplicate independent factorial holdout unexpectedly overwrote evidence")
endif()
