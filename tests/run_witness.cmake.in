set(root "@CMAKE_CURRENT_BINARY_DIR@/ctest_failure_witness")
file(REMOVE_RECURSE "${root}")
set(plugin "@CMAKE_CURRENT_BINARY_DIR@/reverse_sort.so")
set(run "${root}/experiment")
file(MAKE_DIRECTORY "${root}")
file(WRITE "${root}/config.json" "{\"schema_version\":1,\"experiment_id\":\"wrong-plugin-test\",\"problem_family\":\"integer_array\",\"algorithms\":[\"plugin:${plugin}\"],\"seed\":137,\"axes\":{\"n\":{\"values\":[128]}},\"fixed\":{\"distribution\":\"uniform\",\"value_range\":999},\"search\":{\"method\":\"grid\",\"max_cases\":1},\"measurement\":{\"paired_discovery_blocks\":1,\"paired_confirm_blocks\":2,\"warmup_iterations\":0},\"limits\":{\"max_search_queue\":1,\"max_sample_wall_ms\":1000}}")
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" explore --config "${root}/config.json" --out "${run}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE err)
if(NOT status EQUAL 0)
 message(FATAL_ERROR "failure run failed: ${status} ${output} ${err}")
endif()
file(READ "${run}/report.json" report)
string(JSON id GET "${report}" raw_samples 0 case_id)
string(JSON verdict GET "${report}" raw_samples 0 status)
if(NOT verdict STREQUAL "wrong_answer")
 message(FATAL_ERROR "wrong plugin must fail correctness: ${verdict}")
endif()
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" minimize-case --run "${run}" --case "${id}" --algorithm "plugin:${plugin}" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE err)
if(NOT status EQUAL 0)
 message(FATAL_ERROR "minimization failed: ${status} ${output} ${err}")
endif()
file(READ "${run}/witness.json" witness)
string(JSON verdict GET "${witness}" status)
string(JSON old GET "${witness}" original_input_bytes)
string(JSON small GET "${witness}" input_bytes)
string(JSON short_id GET "${witness}" case_id)
if(NOT verdict STREQUAL "MINIMIZED_CONFIRMED" OR NOT small LESS old)
 message(FATAL_ERROR "minimizer failed correctness size gate: ${witness}")
endif()
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" replay --run "${run}" --case "${short_id}" --algorithm "plugin:${plugin}" --expect wrong_answer RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE err)
if(NOT status EQUAL 0 OR NOT output MATCHES "REPLAY EXPECTED_FAILURE")
 message(FATAL_ERROR "witness replay failed: ${status} ${output} ${err}")
endif()
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" replay --run "${run}" --case "${short_id}" --algorithm std_sort --expect wrong_answer RESULT_VARIABLE status)
if(status EQUAL 0)
 message(FATAL_ERROR "correct algorithm must not satisfy expected failure replay")
endif()
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" export --run "${run}" --out "${root}/bundle" RESULT_VARIABLE status OUTPUT_VARIABLE output ERROR_VARIABLE err)
if(NOT status EQUAL 0 OR NOT EXISTS "${root}/bundle/witness.json")
 message(FATAL_ERROR "witness portable bundle missing: ${status} ${output} ${err}")
endif()
