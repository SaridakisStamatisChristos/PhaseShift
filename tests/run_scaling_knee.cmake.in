# Real worker + SQLite integration: a controlled, oracle-correct scaling fixture.
set(root "@CMAKE_CURRENT_BINARY_DIR@/ctest_scaling_knee")
file(REMOVE_RECURSE "${root}")
file(MAKE_DIRECTORY "${root}")
set(plugin "@CMAKE_CURRENT_BINARY_DIR@/scaling_knee.so")
file(WRITE "${root}/config.json" "{\"schema_version\":1,\"experiment_id\":\"controlled-scaling-knee\",\"problem_family\":\"integer_array\",\"algorithms\":[\"plugin:${plugin}\"],\"seed\":1983,\"primary_axis\":\"n\",\"axes\":{\"n\":{\"values\":[16]}},\"fixed\":{\"distribution\":\"uniform\",\"value_range\":256},\"search\":{\"method\":\"grid\",\"max_cases\":1},\"measurement\":{\"paired_discovery_blocks\":1,\"paired_confirm_blocks\":20,\"warmup_iterations\":0,\"minimum_batch_ms\":1},\"limits\":{\"total_wall_seconds\":120,\"max_sample_wall_ms\":1000}}")
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" explore --config "${root}/config.json" --out "${root}/discovery" RESULT_VARIABLE r OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT r EQUAL 0)
  message(FATAL_ERROR "fixture discovery failed ${r}: ${stdout} ${stderr}")
endif()
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" scaling --run "${root}/discovery" --out "${root}/study" --seeds 3 RESULT_VARIABLE r OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT r EQUAL 0)
  message(FATAL_ERROR "fixture scaling failed ${r}: ${stdout} ${stderr}")
endif()
file(READ "${root}/study/scaling.json" evidence)
string(JSON candidate GET "${evidence}" scaling_regime_evidence candidate)
string(JSON status GET "${evidence}" scaling_regime_evidence status)
string(JSON count ERROR_VARIABLE err GET "${evidence}" scaling_regime_evidence holdout_seed_count)
if(NOT candidate OR NOT status STREQUAL "CONFIRMED" OR err OR NOT count EQUAL 20)
  message(FATAL_ERROR "synthetic slope change not tested independently: candidate=${candidate}; status=${status}; holdout=${count}; ${err}")
endif()
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift_scaling_provenance_tests" "${root}/study/run.sqlite" "${root}/study/scaling.json" RESULT_VARIABLE r OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT r EQUAL 0)
  message(FATAL_ERROR "scaling provenance violated: ${stdout} ${stderr}")
endif()
message(STATUS "synthetic scaling regression: ${status}; 20 independent seeds; ${stdout}")
