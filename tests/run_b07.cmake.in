set(root "@CMAKE_CURRENT_BINARY_DIR@/ctest_b07_zero_one")
file(REMOVE_RECURSE "${root}")
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" validate --config "@CMAKE_CURRENT_SOURCE_DIR@/configs/b07_zero_one_bfs.json" RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "B07 setup invalid: ${err}")
endif()
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" explore --config "@CMAKE_CURRENT_SOURCE_DIR@/configs/b07_zero_one_bfs.json" --out "${root}" RESULT_VARIABLE rc ERROR_VARIABLE err)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "B07 timed run failed: ${err}")
endif()
file(READ "${root}/report.json" document)
string(JSON bad GET "${document}" summary invalid_samples)
if(NOT bad EQUAL 0)
 message(FATAL_ERROR "B07 must not produce incorrect/invalid 0-1 BFS or Dijkstra results")
endif()
string(JSON samples GET "${document}" summary samples)
if(samples LESS 50)
 message(FATAL_ERROR "B07 did not produce paired raw timing evidence: samples=${samples}")
endif()
file(READ "${root}/samples.csv" csv)
if(NOT csv MATCHES "zero_one_bfs" OR NOT csv MATCHES "dijkstra_heap")
 message(FATAL_ERROR "B07 missing one comparator in raw CSV")
endif()
# Reject an attempt to compare the restricted BFS to general-weight graphs.
file(READ "@CMAKE_CURRENT_SOURCE_DIR@/configs/b07_zero_one_bfs.json" config)
string(REPLACE "zero_one" "general" invalid "${config}")
file(WRITE "@CMAKE_CURRENT_BINARY_DIR@/b07_invalid.json" "${invalid}")
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" validate --config "@CMAKE_CURRENT_BINARY_DIR@/b07_invalid.json" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
if(rc EQUAL 0)
 message(FATAL_ERROR "B07 accepted incompatible graph weight domain")
endif()
# Keep immutable raw data in the isolated test directory for audit.
message(STATUS "B07 PASS: paired timings, oracle agreement, incompatible weights rejected: ${root}")
