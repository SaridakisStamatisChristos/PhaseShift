set(root "@CMAKE_CURRENT_BINARY_DIR@/ctest_null_ablation")
file(REMOVE_RECURSE "${root}")
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" ablate --config "@CMAKE_CURRENT_SOURCE_DIR@/configs/negative_control.json" --out "${root}" RESULT_VARIABLE rc ERROR_VARIABLE err OUTPUT_QUIET)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "null ablation failed: ${err}")
endif()
file(READ "${root}/ablation_scorecard.json" card)
string(JSON false_positives GET "${card}" null_false_positive_count)
if(NOT false_positives EQUAL 0)
 message(FATAL_ERROR "deterministic null scorecard reported false confirmations")
endif()
string(JSON total GET "${card}" confirmed_discovery_yield_sum)
if(NOT total EQUAL 0)
 message(FATAL_ERROR "null search produced a confirmed boundary")
endif()
file(READ "${root}/ablation.csv" csv)
foreach(method IN ITEMS grid random stratified adaptive_partition)
 if(NOT csv MATCHES "${method},")
  message(FATAL_ERROR "null ablation omitted ${method}")
 endif()
endforeach()
message(STATUS "Null scorecard confirmed none, false positive count zero, all methods measured: ${root}")
