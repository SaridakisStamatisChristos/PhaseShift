set(RUN "@CMAKE_CURRENT_BINARY_DIR@/v2_stratified_ctest")
file(REMOVE_RECURSE "@CMAKE_CURRENT_BINARY_DIR@/v2_stratified_ctest")
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" validate --config "@CMAKE_CURRENT_SOURCE_DIR@/configs/v2/stratified_admissible.json" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "stratified config invalid")
endif()
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" explore --config "@CMAKE_CURRENT_SOURCE_DIR@/configs/v2/stratified_admissible.json" --out "@CMAKE_CURRENT_BINARY_DIR@/v2_stratified_ctest" --pause-after 4 RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "stratified initial slice failed")
endif()
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" resume --run "@CMAKE_CURRENT_BINARY_DIR@/v2_stratified_ctest" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "stratified replay failed")
endif()
execute_process(COMMAND "@Python3_EXECUTABLE@" "@CMAKE_CURRENT_SOURCE_DIR@/tests/verify_v2_stratified.py" --run "@CMAKE_CURRENT_BINARY_DIR@/v2_stratified_ctest" RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "stratified evidence invalid")
endif()
