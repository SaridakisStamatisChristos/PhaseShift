set(root "@CMAKE_CURRENT_BINARY_DIR@/ctest_intervention")
file(REMOVE_RECURSE "${root}")
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" demo --out "${root}/source"
 RESULT_VARIABLE rc ERROR_VARIABLE err OUTPUT_QUIET)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "intervention source demonstration failed: ${err}")
endif()
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" intervene --run "${root}/source" --out "${root}/matched" --pairs 3
 RESULT_VARIABLE rc ERROR_VARIABLE err OUTPUT_QUIET)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "matched intervention failed: ${err}")
endif()
file(READ "${root}/matched/interventions.json" evidence)
string(JSON pairs GET "${evidence}" valid_seed_pairs)
string(JSON causality GET "${evidence}" causal_claim)
string(JSON verdict GET "${evidence}" verdict)
if(NOT pairs EQUAL 3 OR causality OR NOT verdict STREQUAL "MATCHED_MEASUREMENTS_COMPLETE")
 message(FATAL_ERROR "intervention failed to preserve matched seeds/abstention: ${evidence}")
endif()
