set(root "@CMAKE_CURRENT_BINARY_DIR@/ctest_categorical")
file(REMOVE_RECURSE "${root}")
file(MAKE_DIRECTORY "${root}")
file(WRITE "${root}/config.json" "{\"problem_family\":\"integer_array\",\"experiment_id\":\"categorical-control\",\"algorithms\":[\"std_sort\",\"mergesort\"],\"primary_axis\":\"distribution\",\"seed\":8,\"axes\":{\"distribution\":{\"values\":[\"uniform\",\"ascending\",\"all_equal\",\"nearly_sorted\"]}},\"fixed\":{\"n\":128},\"search\":{\"method\":\"grid\",\"max_cases\":4},\"measurement\":{\"paired_discovery_blocks\":1,\"warmup_iterations\":0}}")
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" explore --config "${root}/config.json" --out "${root}/run" RESULT_VARIABLE code ERROR_VARIABLE err)
if(NOT code EQUAL 0)
 message(FATAL_ERROR "categorical search refused valid labels: ${code} ${err}")
endif()
file(READ "${root}/run/report.json" report)
string(JSON verdict GET "${report}" summary hypotheses 0 status)
string(JSON sample_label GET "${report}" raw_samples 0 axis_value)
if(verdict STREQUAL "HYPOTHESIZED")
 string(JSON kind GET "${report}" summary hypotheses 0 kind)
 string(JSON left GET "${report}" summary hypotheses 0 left_label)
 string(JSON right GET "${report}" summary hypotheses 0 right_label)
 if(NOT kind MATCHES "^CATEGORICAL_" OR left STREQUAL right)
  message(FATAL_ERROR "categorical contrasts must preserve unordered category labels and subtype: ${report}")
 endif()
elseif(NOT verdict STREQUAL "NO_CONFIRMED_BOUNDARY")
 message(FATAL_ERROR "unsupported categorical verdict: ${verdict}")
endif()
if(NOT sample_label MATCHES "^(uniform|ascending|all_equal|nearly_sorted)$")
 message(FATAL_ERROR "categorical report failed to preserve labels: ${sample_label}")
endif()
