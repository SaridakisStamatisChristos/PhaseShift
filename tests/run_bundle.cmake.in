set(ROOT "@CMAKE_CURRENT_BINARY_DIR@/bundle_evidence")
file(REMOVE_RECURSE "${ROOT}")
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" demo --out "${ROOT}/run" RESULT_VARIABLE rc OUTPUT_QUIET)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "bundle test demo failed")
endif()
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" export --run "${ROOT}/run" --out "${ROOT}/portable" RESULT_VARIABLE rc OUTPUT_QUIET)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "bundle export failed")
endif()
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" import --bundle "${ROOT}/portable" --out "${ROOT}/restored" RESULT_VARIABLE rc OUTPUT_QUIET)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "bundle import failed")
endif()
file(READ "${ROOT}/restored/report.json" report)
string(JSON id GET "${report}" raw_samples 0 case_id)
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" replay --run "${ROOT}/restored" --case "${id}" RESULT_VARIABLE rc OUTPUT_QUIET)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "imported input failed replay")
endif()
file(APPEND "${ROOT}/portable/report.md" "TAMPER\n")
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" verify-bundle --bundle "${ROOT}/portable" RESULT_VARIABLE rc OUTPUT_QUIET ERROR_QUIET)
if(rc EQUAL 0)
 message(FATAL_ERROR "tampered bundle was accepted")
endif()
file(REMOVE_RECURSE "${ROOT}")
