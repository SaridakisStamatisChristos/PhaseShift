set(ROOT "@CMAKE_CURRENT_BINARY_DIR@/scaling_evidence")
file(REMOVE_RECURSE "${ROOT}")
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" explore --config "@CMAKE_CURRENT_SOURCE_DIR@/configs/topk_fraction.json" --out "${ROOT}/discovery" RESULT_VARIABLE rc OUTPUT_QUIET)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "scaling prerequisite discovery failed")
endif()
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" scaling --run "${ROOT}/discovery" --out "${ROOT}/study" --seeds 3 RESULT_VARIABLE rc OUTPUT_QUIET)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "scaling study failed")
endif()
file(READ "${ROOT}/study/scaling.json" document)
string(JSON status GET "${document}" algorithms topk_heap status)
if(NOT status STREQUAL "EMPIRICAL_FIT")
 message(FATAL_ERROR "scaling models not fitted")
endif()
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift_scaling_provenance_tests" "${ROOT}/study/run.sqlite" "${ROOT}/study/scaling.json" RESULT_VARIABLE provenance_rc OUTPUT_VARIABLE provenance_out ERROR_VARIABLE provenance_err)
if(NOT provenance_rc EQUAL 0)
 message(FATAL_ERROR "scaling provenance invalid: ${provenance_out} ${provenance_err}")
endif()
message(STATUS "${provenance_out}")
