file(REMOVE_RECURSE "@CMAKE_CURRENT_BINARY_DIR@/ctest_ablation")
execute_process(COMMAND "@CMAKE_CURRENT_BINARY_DIR@/phaseshift" ablate --config "@CMAKE_CURRENT_SOURCE_DIR@/configs/adaptive_sparse.json" --out "@CMAKE_CURRENT_BINARY_DIR@/ctest_ablation" RESULT_VARIABLE result OUTPUT_VARIABLE stdout ERROR_VARIABLE stderr)
if(NOT result EQUAL 0)
  message(FATAL_ERROR "Ablation exited ${result}: ${stdout}\n${stderr}")
endif()
file(READ "@CMAKE_CURRENT_BINARY_DIR@/ctest_ablation/ablation.csv" report)
# 24 discovery cases + 40 independently paired confirmation cases + one
# independent oracle-validated negative-control case = 65 total.
if(NOT report MATCHES "adaptive_partition,24,24,65,65,.*CONFIRMED,23,24,0")
  message(FATAL_ERROR "adaptive search did not localize exact threshold under equal discovery budget: ${report}")
endif()
