set(RUN "@CMAKE_CURRENT_BINARY_DIR@/v2_policy_challenge")
file(REMOVE_RECURSE "@CMAKE_CURRENT_BINARY_DIR@/v2_policy_challenge")
execute_process(COMMAND "@Python3_EXECUTABLE@"
 "@CMAKE_CURRENT_SOURCE_DIR@/benchmarks/v2/policy_challenge.py"
 --binary "@CMAKE_CURRENT_BINARY_DIR@/phaseshift"
 --out "@CMAKE_CURRENT_BINARY_DIR@/v2_policy_challenge" --seeds 31 --cases 12 RESULT_VARIABLE rc)
if(NOT rc EQUAL 0)
 message(FATAL_ERROR "four-policy cliff/null challenge failed")
endif()
